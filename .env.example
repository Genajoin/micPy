# Настройки подключения к Parakeet API
PARAKEET_API_URL=http://localhost:5092/v1
PARAKEET_MODEL=parakeet-tdt-0.6b-v3

# --- Звуковые уведомления ---
# Обход «спящего» аудиовыхода без правки системных конфигов.
# PipeWire паркует выход после 5 с тишины, а HDMI-устройства теряют первые
# сотни мс при пробуждении — короткий бип пропадает целиком.
# Подробности и диагностика: SOUND_DEBUGGING.md, Эксперимент 8.

# Не давать аудиовыходу заснуть (самый надёжный обход, тихий фоновый поток)
# MICPY_SOUND_KEEPALIVE=1

# Либо мягче: тишина в начале звука «прогревает» устройство (в мс)
# MICPY_SOUND_WARMUP_MS=400

# Длительность бипа в мс (0 — штатная: 80 для старта, 120 для конца)
# MICPY_SOUND_DURATION_MS=250

# Громкость бипа, 0.0-1.0 (по умолчанию 0.3)
# MICPY_SOUND_VOLUME=0.6
